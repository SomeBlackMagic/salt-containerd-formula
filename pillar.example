# -*- coding: utf-8 -*-
# vim: ft=yaml
#
# Pillar example for the containerd formula.
# All keys are optional; defaults are in containerd/parameters/defaults.yaml.
---
containerd:
  # paths:
  #   prefix: /opt/containerd
  #   bin_dir: /usr/local/bin
  #   sbin_dir: /usr/local/sbin
  #   config_dir: /etc/containerd
  #   certs_dir: /etc/containerd/certs.d

  # keep_versions: 2

  # Override component versions or enable optional components
  # components:
  #   containerd:
  #     version: 2.4.2
  #   runc:
  #     enabled: true
  #     version: 1.5.2
  #     url: https://github.com/opencontainers/runc/releases/download/v{version}/runc.{arch}
  #     checksums:
  #       1.5.2:
  #         amd64: 599f6f94ff8c5057241eff0d54c3c74f95c34935b6457b33fe545defc61e9488
  #   cni:
  #     enabled: true
  #     version: 1.9.1
  #     dir: /opt/cni/bin
  #     url: https://github.com/containernetworking/plugins/releases/download/v{version}/cni-plugins-linux-{arch}-v{version}.tgz
  #     checksums:
  #       1.9.1:
  #         amd64: b98f74a0f8522f0a83867178729c1aa70f2158f90c45a2ca8fa791db1c76b303
  #   crictl:
  #     enabled: true
  #   nerdctl:
  #     enabled: true

  # Remove conflicting distro packages before install
  # conflicts:
  #   packages:
  #     - containerd
  #     - containerd.io
  #     - docker.io
  #     - docker-ce
  #     - runc
  #   remove: false

  # Kernel modules and sysctl for container networking
  # kernel:
  #   enabled: true
  #   modules:
  #     - overlay
  #     - br_netfilter
  #   sysctl:
  #     net.ipv4.ip_forward: 1
  #     net.bridge.bridge-nf-call-iptables: 1
  #     net.bridge.bridge-nf-call-ip6tables: 1

  # /etc/containerd/config.toml (deep-merged with defaults)
  # config:
  #   version: 3
  #   # Set a default key to null to omit it from the serialized TOML.
  #   # imports: null
  #   # plugins:
  #   #   io.containerd.cri.v1.images:
  #   #     registry:
  #   #       config_path: /etc/containerd/certs.d

  # Drop-in configs in /etc/containerd/conf.d/<name>.toml
  # config_d:
  #   20-oom-score:
  #     oom_score: -500

  # Registry mirror / certs.d configuration
  # registries:
  #   docker.io:
  #     server: https://registry-1.docker.io
  #     hosts:
  #       https://mirror.example.com:
  #         capabilities: [pull, resolve]
  #         ca: ca.crt
  #     files:
  #       ca.crt: |
  #         -----BEGIN CERTIFICATE-----
  # registries_purge: false

  # Service management
  # service:
  #   name: containerd
  #   state: running
  #   restart_on_change: true
  #   environment:
  #     HTTPS_PROXY: http://proxy.example.com:3128
  #     NO_PROXY: localhost,127.0.0.1
  #   overrides: {}

  # Cleanup options
  # clean:
  #   purge_data: false

  tofs:
    files_switch:
      - any/path/can/be/used/here
      - id
      - roles
      - osfinger
      - os
      - os_family
